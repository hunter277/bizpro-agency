        }
      },
      "elements": [
        {
          "id": "bpa_pricing_col_table",
          "elType": "column",
          "settings": {
            "_column_size": 100
          },
          "elements": [
            {
              "id": "bpa_pricing_shortcode_widget",
              "elType": "widget",
